---
import { waHref } from "../config";
import SectionHeading from "./SectionHeading.astro";

const ORDER_MESSAGE = "¡Hola Di Simonte! Quiero hacer un pedido.";

const STEPS = [
  "Elegí tus favoritas de la carta.",
  "Escribinos por WhatsApp con tu pedido.",
  "Pasás a buscarla o coordinamos la entrega.",
];
---

<section id="como-pedir" class="py-section">
  <div class="container-shell">
    <div class="rhythm-lines rounded-card p-6 sm:p-10">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
        <!-- Right-third caption (inverted classic, art-direction §7) -->
        <div class="lg:order-2 lg:col-span-4">
          <SectionHeading
            eyebrow="Cómo pedir"
            title="En tres pasos, como en casa."
            reveal="sober"
          />
          <p
            class="mt-6 font-body text-caption italic text-ink-muted"
            data-sober-reveal
            style="--i:1"
          >
            Transferencia o efectivo, como te quede cómodo.
          </p>
        </div>

        <!-- Left two-thirds: numbered step rows with hairline draw -->
        <div class="lg:order-1 lg:col-span-8">
          <ol class="list-none p-0">
            {STEPS.map((step, i) => (
              <li
                class="step-row"
                data-sober-reveal
                data-sober-line
                style={`--i:${i}`}
              >
                <span class="step-num" aria-hidden="true">{i + 1}</span>
                <p class="font-body text-lede font-medium text-cream">{step}</p>
              </li>
            ))}
          </ol>

          <div class="mt-10" data-sober-reveal style="--i:3">
            <a
              class="btn btn-primary btn-banner on-cream"
              href={waHref(ORDER_MESSAGE)}
              target="_blank"
              rel="noopener"
            >
              Hacé tu pedido
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>