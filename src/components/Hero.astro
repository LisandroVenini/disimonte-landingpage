---
import { waHref } from "../config";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import BtnPrimary from "./BtnPrimary.astro";

const ORDER_MESSAGE = "¡Hola Di Simonte! Quiero hacer un pedido.";
---

<section id="inicio" class="relative flex min-h-[100dvh] items-end overflow-hidden" data-hero>
  <!-- Full-bleed AI atmosphere (placeholder until the real scene exists) -->
  <div class="absolute inset-x-0 -inset-y-[10%]" data-hero-bg>
    <MediaPlaceholder
      variant="fullbleed"
      aspect="16 / 9"
      label="Cocina familiar al anochecer"
      note="próxima foto real"
      decorative
      className="h-full w-full"
    />
  </div>
  <!-- Soft dark tonal overlay, lower third (text legibility) -->
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
    style="background: linear-gradient(180deg, rgb(29 50 43 / 0.18) 0%, rgb(29 50 43 / 0.55) 55%, rgb(29 50 43 / 0.82) 100%);"
  ></div>

  <div class="container-shell relative z-10 pb-hero pt-32">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="max-w-3xl lg:col-span-8">
        <p class="eyebrow" data-hero-eyebrow>
          Pastas artesanales de la familia Di Simonte
        </p>
        <h1
          class="mt-6 font-display text-h1 font-medium text-cream"
          data-hero-wordmark
        >
          Di Simonte
        </h1>
        <div
          class="mt-3 h-px w-24 bg-cream/26"
          data-hero-rule
          aria-hidden="true"
        ></div>
        <p
          class="mt-6 font-display text-h2 font-medium text-cream"
          data-hero-manifesto
        >
          Sin stock, con dedicación.
        </p>
        <p class="mt-6 max-w-[45ch] font-body text-lede text-ink-soft" data-hero-sub>
          Pastas premium por encargo y empanadas que vuelan. Hechas por la
          familia, para tu mesa.
        </p>
        <div class="mt-10" data-hero-cta>
          <BtnPrimary href={waHref(ORDER_MESSAGE)} label="Pedir por WhatsApp" />
        </div>
      </div>

      <!-- Tilted polaroid: the "esto es real" trust cue (mobile: inline) -->
      <figure class="lg:col-span-4" data-hero-polaroid>
        <div
          class="mx-auto max-w-[240px] -rotate-2 rounded-card border border-cream/14 bg-surface-raised p-2 shadow-ink transition-transform duration-300 ease-sober hover:rotate-0"
        >
          <MediaPlaceholder
            label="sorrentinos del domingo"
            aspect="4 / 5"
            className="rounded-media"
          />
          <figcaption class="pt-2 text-center font-body text-caption italic text-ink-muted">
            Sorrentinos del domingo
          </figcaption>
        </div>
      </figure>
    </div>
  </div>
</section>