---
/** Isla fija arriba y menú a pantalla completa en el celular (<dialog>). */
import Boton from "./ui/Boton.astro";
import { marca, mensajeGeneral, nav } from "../data/site";
---

<header class="nav">
  <div class="nav__isla">
    <a href="#inicio" class="nav__marca">{marca.nombre}</a>
    <ul class="hidden items-center gap-1 lg:flex">
      {
        nav.map((link) => (
          <li>
            <a href={link.href} class="nav__link">
              {link.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <Boton mensaje={mensajeGeneral} seccion="nav" chico class="hidden sm:inline-flex">Pedir</Boton>
    <button type="button" class="nav__abrir lg:hidden" aria-haspopup="dialog" aria-controls="menu" data-menu-abrir>
      Menú
    </button>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menú">
  <div class="contenedor flex min-h-full flex-col pt-5 pb-8">
    <div class="flex items-center justify-between">
      <span class="font-display text-2xl">{marca.nombre}</span>
      <button type="button" class="nav__abrir" data-menu-cerrar>Cerrar</button>
    </div>
    <ul class="mt-14 flex flex-col gap-1">
      {
        nav.map((link, i) => (
          <li class="menu__item" style={`--i: ${i}`}>
            <a href={link.href} class="menu__link" data-menu-link>
              {link.texto}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto flex flex-col items-start gap-3 pt-12">
      <Boton mensaje={mensajeGeneral} seccion="menu">Pedir por WhatsApp</Boton>
      <a href={marca.instagram.url} target="_blank" rel="noopener" class="py-2 text-lg underline underline-offset-4">
        Instagram {marca.instagram.usuario}<span class="sr-only"> (abre en otra pestaña)</span>
      </a>
    </div>
  </div>
</dialog>

<script>
  import "../scripts/nav";
</script>

<style>
  .nav {
    position: fixed;
    z-index: 50;
    top: 0.75rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding-inline: 0.75rem;
    pointer-events: none;
  }

  .nav__isla {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 68rem;
    padding: 0.375rem 0.375rem 0.375rem 1.25rem;
    border-radius: 999px;
    background: rgb(29 50 43 / 0.86);
    border: 1px solid rgb(254 220 209 / 0.14);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-crema);
    --foco: var(--color-crema);
  }

  .nav__marca {
    margin-right: auto;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1;
    padding-block: 0.8125rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 0.875rem;
    border-radius: 999px;
    font-size: 1.125rem;
    font-weight: 600;
    transition: background-color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__link:hover {
      background: rgb(254 220 209 / 0.1);
    }
  }

  .nav__abrir {
    min-height: 3rem;
    padding-inline: 1.125rem;
    border-radius: 999px;
    border: 1.5px solid rgb(254 220 209 / 0.4);
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 160ms var(--ease-out-fuerte);
  }

  .nav__abrir:active {
    transform: scale(0.97);
  }

  /* ---------- Menú móvil ---------- */

  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-verde);
    color: var(--color-crema);
    --foco: var(--color-crema);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu::backdrop {
    background: var(--color-verde);
  }

  .menu__link {
    display: block;
    padding-block: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 10vw, 3rem);
    line-height: 1.15;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] {
      animation: menu-entra 260ms var(--ease-out-fuerte);
    }

    .menu[open] .menu__item {
      animation: menu-item 360ms var(--ease-out-fuerte) both;
      animation-delay: calc(60ms + var(--i) * 40ms);
    }
  }

  @keyframes menu-entra {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
