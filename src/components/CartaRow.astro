---
import { FLAVOR_HEX, type Product } from "../data/products";
import { waHref } from "../config";

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;
const priceLabel = product.price ?? "Consultá por WhatsApp";
const dotHex = product.flavor ? FLAVOR_HEX[product.flavor] : null;
---

<li data-sober-reveal style={`--i:${index}`}>
  <a
    class="carta-row"
    href={waHref(product.prefill)}
    target="_blank"
    rel="noopener"
    aria-label={`Pedir ${product.name} por WhatsApp`}
  >
    <span
      class="carta-row__dot"
      aria-hidden="true"
      style={dotHex ? { backgroundColor: dotHex } : undefined}
    ></span>
    <span class="min-w-0">
      <span
        class="block font-display font-medium text-cream"
        style="font-size: clamp(1.125rem, 1.8vw, 1.375rem); line-height: 1.2;"
      >
        {product.name}
      </span>
      <span class="hidden font-body text-body text-ink-muted md:block">
        {product.description}
      </span>
    </span>
    <span class="whitespace-nowrap font-body text-price font-semibold text-ink-soft">
      {priceLabel}
    </span>
    <span class="carta-row__arrow" aria-hidden="true">→</span>
  </a>
</li>