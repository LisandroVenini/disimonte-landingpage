---
import { waHref } from "../config";
import SectionHeading from "./SectionHeading.astro";

const ORDER_MESSAGE = "¡Hola Di Simonte! Quiero pedir empanadas para hoy. ¿Qué hay disponible?";

/** Stock chips — flavor dots carry the muted hexes (art-direction §4). */
const STOCK = [
  { label: "Humita — la favorita", hex: "#fbb02d" },
  { label: "Carne cortada a cuchillo", hex: "#7a7672" },
  { label: "Canastitas", hex: "#efb8ae" },
  { label: "Pollo", hex: "#5da365" },
];

const MARQUEE_TEXT = "¡VUELAN! · EMPANADAS · CANASTITAS · ";
---

<section id="semana" class="relative overflow-hidden py-section" data-week>
  <div class="container-shell">
    <!-- Off-grid editorial offset: caption left, chips right -->
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7 lg:translate-y-6">
        <SectionHeading
          eyebrow="La semana"
          title="Empanadas y canastitas. ¡Vuelan!"
          lede="El freezer siempre lleno, la mesa siempre lista. Hechas hoy, para que vos solo disfrutes en casa."
          reveal="cine"
        />
      </div>

      <div class="lg:col-span-5 lg:justify-self-end" aria-label="Sabores de la semana">
        <ul class="flex flex-col items-start gap-3">
          {STOCK.map((chip, i) => (
            <li data-cine-reveal data-cine-delay={i * 0.1 + 0.1}>
              <span class="chip">
                <span
                  class="chip__dot"
                  style={{ backgroundColor: chip.hex }}
                  aria-hidden="true"
                ></span>
                <span class="chip__label">{chip.label}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 text-center" data-cine-band-cta>
      <a
        class="btn btn-primary btn-banner on-cream"
        href={waHref(ORDER_MESSAGE)}
        target="_blank"
        rel="noopener"
      >
        Pedir para hoy
      </a>
    </div>
  </div>

  <!-- Inverted cream marquee band — the site's one light surface (bible §5) -->
  <div class="marquee mt-20 bg-cream text-green" data-cine-marquee aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__group">
        <span class="marquee__text">{MARQUEE_TEXT}</span>
      </span>
      <span class="marquee__group" aria-hidden="true">
        <span class="marquee__text">{MARQUEE_TEXT}</span>
      </span>
    </div>
  </div>
</section>