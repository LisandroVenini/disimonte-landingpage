---
import { LIMITED_PRODUCTS, FLAVOR_HEX } from "../data/products";
import { waHref } from "../config";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import BtnGhost from "./BtnGhost.astro";

const EDITION_MESSAGE = LIMITED_PRODUCTS[0].prefill;
---

<section id="ediciones" class="relative overflow-hidden py-section" data-limited>
  <!-- Full-bleed AI atmosphere (placeholder) + tonal overlay, CTA safe area bottom-right -->
  <div class="absolute inset-0" data-limited-bg>
    <MediaPlaceholder
      variant="fullbleed"
      aspect="16 / 9"
      label="Focaccia y pizzas prelistas al atardecer"
      note="próxima foto real"
      decorative
      className="h-full w-full"
    />
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background: linear-gradient(205deg, rgb(29 50 43 / 0.28) 0%, rgb(29 50 43 / 0.55) 45%, rgb(29 50 43 / 0.86) 100%);"
    ></div>
  </div>

  <div class="container-shell relative z-10">
    <div class="ml-auto max-w-xl lg:mr-8">
      <div class="flex items-center gap-3" data-cine-reveal data-cine-delay={0}>
        <span class="badge badge--pulse">
          <span class="badge__dot" aria-hidden="true"></span>
          <span class="badge__label">Stock limitado</span>
        </span>
      </div>

      <p class="eyebrow mt-6" data-cine-reveal data-cine-delay={0.1}>
        Laboratorio de sabores
      </p>
      <h2
        class="mt-5 font-display text-h2 text-cream"
        data-cine-reveal
        data-cine-delay={0.2}
      >
        Ediciones limitadas.
      </h2>
      <p
        class="mt-5 max-w-[45ch] font-body text-lede text-ink-soft"
        data-cine-reveal
        data-cine-delay={0.3}
      >
        Focaccia y pizzas prelistas salidas del laboratorio de la familia.
        Tiradas chicas, antojo grande: cuando se acaban, se acaban. Tic-tac.
      </p>

      <!-- Lab line-up (names from data; restraint feeds the exclusivity) -->
      <div class="mt-8 flex flex-wrap items-center gap-3" data-cine-reveal data-cine-delay={0.4}>
        {LIMITED_PRODUCTS.map((product) => (
          <span class="chip chip--bare">
            <span class="chip__dot" style={{ backgroundColor: FLAVOR_HEX.espinaca }} aria-hidden="true"></span>
            <span class="chip__label">{product.name}</span>
          </span>
        ))}
      </div>

      <div class="mt-10" data-cine-reveal data-cine-delay={0.5}>
        <BtnGhost href={waHref(EDITION_MESSAGE)} label="Pedir la edición" />
      </div>
    </div>
  </div>
</section>