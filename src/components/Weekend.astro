---
import { SORRENTINOS, LASAGNA } from "../data/products";
import SectionHeading from "./SectionHeading.astro";
import ProductCard from "./ProductCard.astro";
import LasagnaBandeja from "./LasagnaBandeja.astro";

const [calabaza, espinaca, jyq, bondiola] = SORRENTINOS;
const CTA = "Pedir este sábado";
---

<section id="fin-de-semana" class="py-section">
  <div class="container-shell">
    <SectionHeading
      eyebrow="El fin de semana"
      title="Los domingos se heredan."
      lede="Sorrentinos y lasagna, por encargo. Sin stock, con dedicación: cocinamos bajo pedido porque el respeto por una receta heredada no permite apuros."
      reveal="sober"
    />
    <p
      class="mt-6 font-body text-caption italic text-ink-muted"
      data-sober-reveal
      style="--i:1"
    >
      Los sabores van alternando los findes. Seguí las novedades en Instagram y
      WhatsApp.
    </p>

    <!-- Asymmetric 2-up editorial split (no 3-equal-card rows, bible §7) -->
    <div class="mt-14 grid gap-6 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <ProductCard product={calabaza} ctaLabel={CTA} />
      </div>
      <div class="lg:col-span-5">
        <ProductCard product={espinaca} ctaLabel={CTA} />
      </div>
      <div class="lg:col-span-5">
        <ProductCard product={jyq} ctaLabel={CTA} />
      </div>
      <div class="lg:col-span-7">
        <ProductCard product={bondiola} ctaLabel={CTA} />
      </div>
      <div class="lg:col-span-12">
        <LasagnaBandeja product={LASAGNA} ctaLabel={CTA} />
      </div>
    </div>
  </div>
</section>