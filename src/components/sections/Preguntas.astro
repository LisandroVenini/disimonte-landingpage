---
/** Preguntas con <details> nativo: se abren con teclado y sin JavaScript. */
import Boton from "../ui/Boton.astro";
import TituloSeccion from "../ui/TituloSeccion.astro";
import { preguntas, preguntasFrecuentes } from "../../data/faq";
---

<section id="preguntas" class="fondo-verde seccion" aria-labelledby="preguntas-titulo">
  <div class="contenedor grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-20">
    <div class="flex flex-col items-start gap-8">
      <TituloSeccion id="preguntas-titulo" titulo={preguntasFrecuentes.titulo} />
      <Boton mensaje={preguntasFrecuentes.mensaje} seccion="preguntas" variante="contorno">
        {preguntasFrecuentes.boton}
      </Boton>
    </div>

    <div class="border-t border-crema/20">
      {
        preguntas.map((p) => (
          <details class="pregunta border-b border-crema/20">
            <summary class="flex min-h-[3.5rem] cursor-pointer items-center justify-between gap-6 py-4 text-[1.375rem] font-semibold leading-snug">
              {p.pregunta}
              <span class="pregunta__icono" aria-hidden="true" />
            </summary>
            <p class="texto pb-6 opacity-90">
              {p.respuesta}
              {p.link && (
                <>
                  {" "}
                  <a href={p.link.href} class="font-semibold underline underline-offset-4">
                    {p.link.texto}
                  </a>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .pregunta__icono {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .pregunta__icono::before,
  .pregunta__icono::after {
    content: "";
    position: absolute;
    left: 0;
    top: calc(50% - 1px);
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 200ms var(--ease-out-fuerte);
  }

  .pregunta__icono::after {
    transform: rotate(90deg);
  }

  .pregunta[open] .pregunta__icono::after {
    transform: rotate(0deg);
  }
</style>
