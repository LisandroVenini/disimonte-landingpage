---
import { Picture } from "astro:assets";
import Boton from "../ui/Boton.astro";
import { inicio, marca } from "../../data/site";
import fotoInicio from "../../assets/fotos/inicio.png";
---

<section id="inicio" class="inicio fondo-verde relative isolate flex min-h-svh items-end overflow-hidden">
  <div class="inicio__foto absolute inset-0 -z-10">
    <Picture
      src={fotoInicio}
      alt=""
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[640, 960, 1376]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[72%_center] md:object-center"
    />
    <div class="inicio__cortina absolute inset-0" aria-hidden="true"></div>
  </div>
  <div class="inicio__velo absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="contenedor pt-32 pb-14 md:pb-20">
    <div class="flex max-w-[40rem] flex-col items-start">
      <p class="inicio__pieza text-lg tracking-wide opacity-85" style="--i: 0">{marca.ubicacion}</p>
      <h1 class="inicio__pieza titulo-inicio mt-2" style="--i: 1">{inicio.titulo}</h1>
      <p
        class="inicio__pieza mt-3 font-body text-[clamp(1.75rem,3.6vw,2.75rem)] leading-tight italic"
        style="--i: 2"
      >
        {inicio.frase}
      </p>
      <p class="inicio__pieza bajada mt-5" style="--i: 3">{inicio.bajada}</p>
      <div class="inicio__pieza mt-8" style="--i: 4" data-inicio-cta>
        <Boton mensaje={inicio.mensaje} seccion="inicio">{inicio.boton}</Boton>
      </div>
    </div>
  </div>
</section>

<style>
  /* En el celular la foto ocupa la parte de arriba y el texto va debajo,
     para no tapar las manos. En pantallas anchas la foto va completa. */
  .inicio__foto {
    bottom: auto;
    height: 64svh;
  }

  .inicio__velo {
    background:
      linear-gradient(to bottom, rgb(29 50 43 / 0.55) 0%, transparent 18%),
      linear-gradient(to top, var(--color-verde) 36svh, rgb(29 50 43 / 0.6) 46svh, transparent 60svh);
  }

  @media (width >= 48rem) {
    .inicio__foto {
      bottom: 0;
      height: auto;
    }

    .inicio__velo {
      background:
        linear-gradient(to top, rgb(29 50 43 / 0.75) 0%, transparent 45%),
        linear-gradient(
          to right,
          var(--color-verde) 0%,
          rgb(29 50 43 / 0.85) 32%,
          rgb(29 50 43 / 0.2) 62%,
          transparent 100%
        );
    }
  }

  /* Entrada al cargar: solo CSS, una vez. 60 ms entre piezas, ~900 ms en total */
  /* La foto se pinta desde el primer cuadro (cuenta para el LCP) y una
     cortina verde se encoge hacia arriba: se descubre de abajo hacia arriba. */
  .inicio__cortina {
    background: var(--color-verde);
    transform-origin: top;
    transform: scaleY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .inicio__cortina {
      animation: descubrir 900ms var(--ease-out-fuerte) both;
    }

    .inicio__pieza {
      animation: entrar 660ms var(--ease-out-fuerte) both;
      animation-delay: calc(var(--i) * 60ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inicio__pieza {
      animation: aparecer 400ms ease both;
    }
  }

  @keyframes descubrir {
    from {
      transform: scaleY(1);
    }
    to {
      transform: scaleY(0);
    }
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
</style>
