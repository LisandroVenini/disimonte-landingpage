---
/**
 * La bandeja: las piezas son botones que resaltan su lista. bandeja.ts
 * agrega el estado de espera y las hace caer una sola vez al entrar.
 */
import { Picture } from "astro:assets";
import Boton from "../ui/Boton.astro";
import TituloSeccion from "../ui/TituloSeccion.astro";
import { paraLaMano } from "../../data/productos";
---

<section id="para-la-mano" class="fondo-verde seccion overflow-x-clip" aria-labelledby="para-la-mano-titulo">
  <div class="contenedor">
    <TituloSeccion id="para-la-mano-titulo" titulo={paraLaMano.titulo} bajada={paraLaMano.bajada} />

    <div class="mt-12 grid items-start gap-12 lg:mt-16 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
      <div class="bandeja" data-bandeja>
        <div class="bandeja__tabla" aria-hidden="true"></div>
        {
          paraLaMano.grupos.map((grupo, i) => (
            <button
              type="button"
              class={`pieza pieza--${grupo.id}`}
              style={`--i: ${i}`}
              data-pieza={grupo.id}
              aria-controls={`lista-${grupo.id}`}
              aria-pressed="false"
            >
              <span class="pieza__sombra" aria-hidden="true" />
              <span class="pieza__caida">
                <span class="pieza__flote">
                  <Picture
                    src={grupo.foto}
                    alt=""
                    formats={["avif", "webp"]}
                    widths={[250, 500]}
                    sizes="(min-width: 1024px) 22vw, 45vw"
                    class="h-auto w-full"
                  />
                </span>
              </span>
              <span class="sr-only">Ver {grupo.nombre.toLowerCase()}</span>
            </button>
          ))
        }
      </div>

      <div class="flex flex-col gap-4">
        {
          paraLaMano.grupos.map((grupo) => (
            <div class="lista" id={`lista-${grupo.id}`} data-lista={grupo.id}>
              <h3 class="titulo-tarjeta flex items-baseline justify-between gap-4">
                {grupo.nombre}
                {grupo.nota && <span class="font-body text-lg italic opacity-80">{grupo.nota}</span>}
              </h3>
              <ul class="mt-3 flex flex-col gap-3">
                {grupo.items.map((item) => (
                  <li>
                    <p class="text-[1.3125rem] font-semibold leading-snug">{item.nombre}</p>
                    <p class="leading-snug opacity-85">{item.descripcion}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="mt-4">
          <Boton mensaje={paraLaMano.mensaje} seccion="para-la-mano">{paraLaMano.boton}</Boton>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/bandeja";
</script>

<style>
  .bandeja {
    position: relative;
    aspect-ratio: 6 / 5;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .bandeja__tabla {
    position: absolute;
    inset: 10% 2% 4%;
    border-radius: 2.25rem;
    background:
      radial-gradient(120% 90% at 30% 20%, #ffe9e1 0%, transparent 60%),
      var(--color-crema);
    box-shadow:
      inset 0 0 0 0.6rem rgb(29 50 43 / 0.06),
      inset 0 -1.25rem 2.5rem rgb(107 68 40 / 0.12),
      0 2.5rem 4rem -1.5rem rgb(0 0 0 / 0.5);
    transform: rotate(-2deg);
  }

  .pieza {
    position: absolute;
    display: block;
    cursor: pointer;
    border-radius: 50%;
    --foco: var(--color-verde);
  }

  .pieza--empanadas {
    left: 2%;
    top: 6%;
    width: 52%;
  }

  .pieza--canastitas {
    right: 1%;
    top: 2%;
    width: 48%;
  }

  .pieza--pizza {
    left: 23%;
    bottom: 0;
    width: 55%;
  }

  .pieza__caida,
  .pieza__flote {
    display: block;
  }

  .pieza__flote {
    transition: transform 220ms var(--ease-out-fuerte);
  }

  .pieza.es-activa .pieza__flote {
    transform: translateY(-6px);
  }

  @media (hover: hover) and (pointer: fine) {
    .pieza:hover .pieza__flote {
      transform: translateY(-6px);
    }
  }

  .pieza__sombra {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 12%;
    height: 18%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(41 41 41 / 0.35), transparent);
  }

  /* ---------- Caída (estado de espera lo agrega bandeja.ts) ---------- */

  @media (prefers-reduced-motion: no-preference) {
    .bandeja--espera .pieza__caida {
      opacity: 0;
      transform: translateY(-140%) rotate(-14deg);
    }

    .bandeja--espera .pieza__sombra {
      opacity: 0;
      transform: scale(0.35);
    }

    .bandeja--espera.cae .pieza__caida,
    .bandeja--espera.cae .pieza__sombra {
      opacity: 1;
      transform: none;
      transition:
        transform 600ms var(--ease-rebote),
        opacity 240ms ease;
      transition-delay: calc(var(--i) * 120ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bandeja--espera .pieza {
      opacity: 0;
    }

    .bandeja--espera.cae .pieza {
      opacity: 1;
      transition: opacity 500ms ease;
    }
  }

  /* ---------- Listas ---------- */

  .lista {
    border-radius: 1.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1.5px solid rgb(254 220 209 / 0.14);
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .lista.es-resaltada {
    background: var(--color-verde-claro);
    border-color: rgb(254 220 209 / 0.55);
  }
</style>
