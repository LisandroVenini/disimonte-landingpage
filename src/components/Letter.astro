---
import { LETTER_PRODUCTS } from "../data/products";
import SectionHeading from "./SectionHeading.astro";
import CartaRow from "./CartaRow.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";

/** Small real-photo thumbnail tiles beside the list (art-direction §5). */
const THUMBS = [
  { label: "sorrentinos de calabaza", tone: "calabaza" },
  { label: "sorrentinos de espinaca", tone: "espinaca" },
  { label: "canastitas de la semana", tone: null },
] as const;
---

<section id="carta" class="py-section">
  <div class="container-shell">
    <div class="letter-column">
      <SectionHeading
        eyebrow="La carta"
        title="Elegí tus favoritas."
        lede="Todas con sello de autor: sin colorantes, masa natural, repulgue a mano. La disponibilidad de la semana se anuncia en Instagram y WhatsApp."
        align="center"
        reveal="sober"
      />
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[clamp(120px,14vw,160px)_minmax(0,1fr)] lg:gap-16">
      <!-- Left-edge thumbnail stack (lg only) -->
      <div class="hidden flex-col gap-5 lg:flex" aria-hidden="true">
        {THUMBS.map((thumb, i) => (
          <div data-sober-reveal style={`--i:${i}`}>
            <MediaPlaceholder
              variant="framed"
              tone={thumb.tone ?? "none"}
              aspect="1 / 1"
              label={thumb.label}
            />
          </div>
        ))}
      </div>

      <!-- The letter: a semantic list (bible §10) -->
      <div class="letter-column" style="max-width: none">
        <ul class="carta-list">
          {LETTER_PRODUCTS.map((product, i) => (
            <CartaRow product={product} index={i} />
          ))}
        </ul>
        <p
          class="mt-8 text-center font-body text-caption italic text-ink-muted"
          data-sober-reveal
          style="--i:8"
        >
          ¿Dudas? Escribinos — respondemos siempre.
        </p>
      </div>
    </div>
  </div>
</section>