---
import type { Product } from "../data/products";
import { waHref } from "../config";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import FlavorChip from "./FlavorChip.astro";
import BtnPrimary from "./BtnPrimary.astro";

interface Props {
  product: Product;
  ctaLabel?: string;
  className?: string;
}

const { product, ctaLabel = "Pedir", className = "" } = Astro.props;
const priceLabel =
  product.price ?? "Consultá por WhatsApp";
const mediaLabel = product.name.charAt(0).toLowerCase() + product.name.slice(1);
---

<div class:list={["product-card", className]} data-sober-reveal>
  <div class="double-bezel">
    <div class="double-bezel__core">
      <div class="relative">
        <MediaPlaceholder
          label={mediaLabel}
          aspect="4 / 5"
          className="product-card__media"
        />
        {product.flavor && (
          <FlavorChip
            flavor={product.flavor}
            label={product.name}
            className="absolute left-3 top-3 z-10"
          />
        )}
      </div>
      <div class="product-card__body">
        <h3 class="font-display text-h3 text-cream">{product.name}</h3>
        <p class="mt-3 max-w-[65ch] font-body text-body text-ink-soft">
          {product.description}
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <p class="font-body text-price font-semibold text-cream">
            {priceLabel}
          </p>
          <BtnPrimary href={waHref(product.prefill)} label={ctaLabel} />
        </div>
      </div>
    </div>
  </div>
</div>