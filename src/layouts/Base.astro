---
import "@fontsource/playfair-display/500.css";
import "@fontsource/playfair-display/600.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "../styles/global.css";

import playfair500 from "@fontsource/playfair-display/files/playfair-display-latin-500-normal.woff2?url";
import cormorant500 from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url";

import { marca, seo } from "../data/site";
import { WHATSAPP_VISIBLE } from "../lib/whatsapp";

interface Props {
  title?: string;
  description?: string;
}

const { title = seo.titulo, description = seo.descripcion } = Astro.props;

const datosNegocio = {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  name: marca.nombre,
  description,
  servesCuisine: ["Pastas caseras", "Empanadas"],
  telephone: `+54 9 ${WHATSAPP_VISIBLE}`,
  image: new URL("/og.jpg", Astro.site ?? Astro.url).href,
  areaServed: {
    "@type": "City",
    name: "Posadas",
    containedInPlace: { "@type": "State", name: "Misiones" },
  },
  sameAs: [marca.instagram.url],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1D322B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={playfair500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorant500} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(datosNegocio)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-crema focus:px-5 focus:py-3 focus:text-verde"
      href="#contenido">Saltar al contenido</a
    >
    <slot />
  </body>
</html>
