---
import Base from "../layouts/Base.astro";
import Boton from "../components/ui/Boton.astro";
import { mensajeGeneral } from "../data/site";
---

<Base>
  <main id="contenido" class="contenedor seccion flex flex-col items-start gap-6">
    <h1 class="titulo-inicio">Di Simonte</h1>
    <p class="bajada">Prueba de la base.</p>
    <Boton mensaje={mensajeGeneral} seccion="prueba">Pedir por WhatsApp</Boton>
  </main>
</Base>
